{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "correctness",
          "minLength": 2,
          "title": "Category",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "requirement_id": {
          "default": "",
          "title": "Requirement Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggested_fix": {
          "default": "",
          "title": "Suggested Fix",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "blocker",
        "major",
        "minor",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "approve",
        "request_changes"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "https://agentic.dev/schemas/Review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict",
      "default": "approve"
    }
  },
  "required": [
    "summary"
  ],
  "title": "Review",
  "type": "object",
  "x-agentic-artifact": "Review"
}
